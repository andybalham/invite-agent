APP_ENV=local
API_PORT=14000
WEB_PORT=15173
DYNAMODB_PORT=18000
AWS_REGION=eu-west-2
DYNAMODB_ENDPOINT=http://127.0.0.1:18000
APP_TABLE_NAME=invite-agent-local-app
AUDIT_TABLE_NAME=invite-agent-local-audit
PUBLIC_BASE_URL=http://127.0.0.1:15173
AUTH_MODE=local
# T-141 contract; composition wiring is T-142. Supply a private persistent ring;
# no checked-in or startup-generated default may be used with retained poll data.
# PUBLIC_TOKEN_ENCRYPTION_ACTIVE_KEY_ID=<private-key-id>
# PUBLIC_TOKEN_ENCRYPTION_KEYS=<JSON object mapping key ids to 32-byte Base64URL keys>
# Keys must be independent of PUBLIC_TOKEN_HASH_KEY. See .docs/owner-share-link-contract.md.
